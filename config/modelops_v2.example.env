# ModelOps v2 app settings
USE_MODELOPS_S3=true
MODEL_BUCKET=pfs-modelops-<account>-us-east-1
MODELOPS_PREFIX=modelops/latest
MODELOPS_REGISTRY_PREFIX=modelops/registry
APP_EXPORT_BUCKET=pfs-modelops-<account>-us-east-1
APP_EXPORT_PREFIX=app/batch_exports
AWS_REGION=us-east-1

# Local debug
MODELOPS_LOCAL_ROOT=modelops_outputs
DATA_DIR=data

# Optional: set true if running locally without RDS access
DISABLE_RDS_WRITES=false
