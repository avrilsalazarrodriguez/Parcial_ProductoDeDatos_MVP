        return False

    try:
        _insert_batch_export(
            scope=scope,
            shop_id=shop_id,
            records_count=records_count,
            total_prediction=total_prediction,
            s3_uri=s3_uri,
        )
        return True
    except Exception as exc:  # noqa: BLE001
        _log_nonfatal_rds_error("insert_batch_export", exc)
        return False


def read_batch_exports(limit: int = 20) -> pd.DataFrame:
