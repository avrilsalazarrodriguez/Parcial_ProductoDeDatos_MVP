def _log_nonfatal_rds_error(action: str, exc: Exception) -> None:
    """Registra errores de RDS sin romper la UI local de Streamlit."""
    LOGGER.warning(
        "action=%s status=skipped error_type=%s error_message=%s",
        action,
        type(exc).__name__,
        str(exc)[:300],
    )


def insert_usage_event(
    event_type: str,
    shop_id: int | None = None,
    item_id: int | None = None,
    records_count: int | None = None,
    status: str = "success",
    message: str | None = None,
) -> bool:
    """Registra eventos de uso si RDS está disponible.

    En local, si `DISABLE_RDS_WRITES=true`, no intenta conectarse a RDS.
    Esto evita que la app se caiga por no encontrar el stack `pfs-mvp-rds`.
    """
    if DISABLE_RDS_WRITES:
        return False

    try:
        _insert_usage_event(
            event_type=event_type,
            shop_id=shop_id,
            item_id=item_id,
            records_count=records_count,
            status=status,
            message=message,
        )
        return True
    except Exception as exc:  # noqa: BLE001
        _log_nonfatal_rds_error("insert_usage_event", exc)
        return False


def insert_batch_export(
    scope: str,
    shop_id: int | None,
    records_count: int,
    total_prediction: float,
    s3_uri: str,
) -> bool:
    """Registra el historial del archivo CFO si RDS está disponible."""
